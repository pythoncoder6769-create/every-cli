# Force LF line endings for shell scripts and Unix executables across all OSes
* text=auto
*.sh text eol=lf
every-cli text eol=lf
Makefile text eol=lf
completions/* text eol=lf
man/* text eol=lf
*.md text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf

# Windows specific
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
